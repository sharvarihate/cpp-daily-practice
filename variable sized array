#include <iostream>
#include <vector>
using namespace std;

int main(){
    int n, q;
    cin>> n>> q;
    vector<vector<int>> arr(n);
    for (int i=0; i<n ; i++){
        int k;
        cin>>k;
        for (int j=0; j<k; j++){
            int value;
            cin >> value ;
            arr[i].push_back (value);
        }
    }
    for (int i=0; i<q; i++){
        int x, y;
        cin >> x >> y;
        cout << arr[x][y] <<endl ;
    }
    return 0;
}
