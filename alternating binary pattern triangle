#include <bits/stdc++.h>
using namespace std;

class solution {
public:
    void printAlternatingBinaryTriangle(int n) {
       for ( int i= 0 ; i< n; i++){
           int k= (i%2==0) ? 1 :0;
           for (int j=0; j<=i; j++){
               cout << k<< " ";
               k = 1 - k;
           }
           cout << endl;
       }
    }
};
