#include <bits/stdc++.h>
using namespace std;

class solution {
public:
    int countVowels(string str) {
        int vowels = 0;
        for (char ch : str) {
            if (ch == 'a' || ch == 'e' || ch == 'i' ||
                ch == 'o' || ch == 'u' ||
                ch == 'A' || ch == 'E' || ch == 'I' ||
                ch == 'O' || ch == 'U') {
                vowels++;
            }
        }
        return vowels;
    }
};
