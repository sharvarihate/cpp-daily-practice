#include<bits/stdc++.h>
using namespace std;

class solution{
public:
    void sumOfDiagonals(int matrix[][1000], int n) {
        int primarySum = 0, secondarySum = 0;
        
        for (int i = 0; i < n; i++) {
            primarySum += matrix[i][i];
            secondarySum += matrix[i][n-i-1];
        }
        
        cout << primarySum << " " << secondarySum << endl;
    }
};

