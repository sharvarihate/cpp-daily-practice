#include<bits/stdc++.h>
using namespace std;
 
class solution {
public:
    void manipulateArray(int arr[], int n, int k) {
        int middleIndex = 0;
        
        if(n % 2 == 0) {
            middleIndex = (n / 2) - 1;
        }
        else {
            middleIndex = n / 2;
        }
        
        arr[middleIndex] *= k;
    }
};

